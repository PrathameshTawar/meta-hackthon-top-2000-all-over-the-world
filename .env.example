# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://saath:saath@localhost:5432/saath

# ── Meta / Fireworks AI ───────────────────────────────────────────────────────
# Get your key from https://fireworks.ai
META_API_KEY=fw_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Exact model IDs — confirm from the hackathon docs before using
MUSE_VOICE_MODEL=accounts/fireworks/models/whisper-v3
MUSE_SPARK_MODEL=accounts/fireworks/models/llama-v3p2-11b-vision-instruct

# ── Telegram ──────────────────────────────────────────────────────────────────
# Get token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# A random string you generate — set the same value when registering the webhook
TELEGRAM_WEBHOOK_SECRET=change_me_to_a_random_string

# ── App ───────────────────────────────────────────────────────────────────────
# Your public backend URL (used in escalation messages)
BASE_URL=https://your-backend.railway.app
FRONTEND_URL=https://your-app.vercel.app

# Language for agent replies: "mr" (Marathi) or "hi" (Hindi)
DEFAULT_LANGUAGE=mr

# Escalation: ping all siblings when deadline is this many days away
ESCALATION_DAYS_BEFORE=3
