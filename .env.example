# ── Database ──────────────────────────────────────────────────────────────────
# Default to local SQLite for zero-setup dev & evaluation
DATABASE_URL=sqlite+aiosqlite:///./saath.db
# For production Docker / PostgreSQL (also preconfigured in docker-compose.yml):
# DATABASE_URL=postgresql+asyncpg://saath:saath@localhost:5432/saath

# ── Meta Muse Spark Open / LLM Configuration ──────────────────────────────────
# Official Meta Model API endpoint (https://api.meta.ai/v1)
LLM_BASE_URL=https://api.meta.ai/v1
LLM_API_KEY=your_meta_api_key_here
MUSE_SPARK_MODEL=muse-spark-1.3
MUSE_VOICE_MODEL=muse-voice-transcribe-1.0
# Backup / Alternative: Baseten endpoint
# LLM_BASE_URL=https://inference.baseten.co/v1
# MUSE_SPARK_MODEL=meta-models/muse-spark-open-1026

# ── Security & Admin ─────────────────────────────────────────────────────────
# Change this secret before deploying to production. Required for web board & admin APIs.
# If empty, admin and task APIs return 503 (ADMIN_SECRET not configured).
ADMIN_SECRET=saath_admin_secret_demo

# ── WhatsApp Cloud API (Meta) ──────────────────────────────────────────────────
# From your Meta App Dashboard -> WhatsApp -> API Setup
WHATSAPP_TOKEN=EAAG...your_whatsapp_access_token...
WHATSAPP_PHONE_NUMBER_ID=100000000000000
WHATSAPP_VERIFY_TOKEN=your_secure_verify_token_here
WHATSAPP_APP_SECRET=your_meta_app_secret_for_hmac
WHATSAPP_API_VERSION=v22.0

# ── Telegram ──────────────────────────────────────────────────────────────────
# Get token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Required: Webhook secret token. Telegram posts and bot.py forwarders must match this token
TELEGRAM_WEBHOOK_SECRET=change_me_to_a_random_string

# ── Demo Phone Numbers (Load real phones without committing to Git) ────────────
DEMO_BABA_PHONE=+919800000001
DEMO_AAI_PHONE=+919800000002
DEMO_ROHAN_PHONE=+919800000003
DEMO_PRIYA_PHONE=+919800000004
DEMO_AMIT_PHONE=+919800000005
DEMO_GUARDIAN_PHONE=+919800000006

# ── App & Frontend ─────────────────────────────────────────────────────────────
BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
DEFAULT_LANGUAGE=mr
ESCALATION_DAYS_BEFORE=3

# ── Scheduler & Background Jobs ──────────────────────────────────────────────
# When running multiple backend processes / uvicorn workers, enable the escalation
# scheduler on only ONE worker/process to prevent duplicate notifications.
RUN_SCHEDULER=true

# ── Health Module ─────────────────────────────────────────────────────────────
DOSE_ESCALATE_AFTER_MINUTES=120
